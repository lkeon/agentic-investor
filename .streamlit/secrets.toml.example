# Paste these root-level values into Streamlit Community Cloud's Secrets field.
# Never commit a real `.streamlit/secrets.toml`.

# Required: external PostgreSQL with pgvector and the populated canonical
# mental-model tables. Add the provider's required TLS query parameter.
DATABASE_URL = "postgresql+psycopg://user:password@host:5432/database?sslmode=require"

# Required for the fixed OpenAI embedding and retrieval layer.
OPENAI_API_KEY = "replace-with-openai-key"

# Required while reasoning stages are routed through OpenRouter.
OPENROUTER_API_KEY = "replace-with-openrouter-key"
OPENROUTER_API_BASE = "https://openrouter.ai/api/v1"
OR_SITE_URL = "https://your-app-name.streamlit.app"
OR_APP_NAME = "The Diligence Room"

# Hosted-session safeguards: no cross-session latest-result loading and
# per-run temporary result artifacts.
DILIGENCE_DEPLOYMENT = "streamlit_cloud"

# OpenAI remains the fallback for unqualified direct-provider model names.
# All reasoning stages currently inherit the DeepSeek model through OpenRouter.
DEFAULT_REASONING_PROVIDER = "openai"
DEFAULT_REASONING_MODEL = "openrouter/deepseek/deepseek-v4-flash"
