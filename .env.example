# Infrastructure and credentials used by the pipeline and Crew retrieval.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/database_name
OPENAI_API_KEY=your-api-key

# Optional OpenRouter connection for crew reasoning models only.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OR_SITE_URL=
OR_APP_NAME="The Diligence Room"

# Fragment extraction model used while building the mental-model database.
FRAGMENT_EXTRACTION_MODEL=gpt-5.6-terra

# Canonical model generation settings for the mental-model database.
CANONICAL_PROVIDER=openai
CANONICAL_MODEL=gpt-5.6-luna
CANONICAL_REASONING_EFFORT=low

# Hierarchy and relationship settings for the mental-model database.
HIERARCHY_PROVIDER=openai
HIERARCHY_MODEL=gpt-5.6-luna
HIERARCHY_REASONING_EFFORT=low

# Crew MVP reasoning models. Use openrouter/<provider>/<model> to route a
# stage through OpenRouter; direct provider-qualified names remain supported.
DEFAULT_REASONING_PROVIDER=openai
DEFAULT_REASONING_MODEL=openai/gpt-5-nano-2025-08-07
QUESTION_MODEL=openai/gpt-5-nano-2025-08-07
RESEARCH_MODEL=openai/gpt-5-nano-2025-08-07
BRIDGE_MODEL=openai/gpt-5-nano-2025-08-07
INVESTOR_MODEL=openai/gpt-5-nano-2025-08-07
CIO_MODEL=openai/gpt-5-nano-2025-08-07
